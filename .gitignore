# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Environments
env/
venv/
.venv/
lib/

# Database
*.duckdb
*.duckdb.wal
*.db

# Stanza Resources
stanza_resources/
home/stanza_resources/

# Corpora (Exclude all by default, then selectively include)
corpora/**/*.txt
corpora/**/*.xml
corpora/**/*.db
corpora/**/*.duckdb

# Corpora Whitelist (User explicitly wants these pushed)
!corpora/english/xml_tag_demo.xml
!corpora/indonesian/ID-BPPT-tagged.xml
!corpora/english/EN-BPPT-tagged.xml
!corpora/english/BrownCorpus.xml
!corpora/indonesian/KOSLAT-full.xml


# Temporary / Testing
test_stanza_standalone.py
dummy_corpus.duckdb/
.streamlit/secrets.toml
.DS_Store
Thumbs.db
*.pptx
tests/*.txt
tests/*.xml
tests/debug_*.py
tests/diag_*.py
tests/check_*.py
tests/prototype_*.py
tests/trace_*.py
tests/verify_*.py
tests/extract_*.py
tests/generate_*.py

# Logs and Scratch
*.log
scratch/

# _dont_push folder
_dont_push/

# TreeTagger Models
treetagger/language_model/*
!treetagger/language_model/english/
!treetagger/language_model/indonesian/
!treetagger/language_model/chinese/
!treetagger/language_model/malagasy/

# Ensure Chinese tokenizer is pushed
!treetagger/tokenizer/
