# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Environments
env/
venv/
.venv/
lib/

# Database (Exclude by default)
*.db
*.duckdb.wal

# Corpora (Exclude all by default, then selectively include duckdb versions)
corpora/**/*.txt
corpora/**/*.xml
corpora/**/*.db
corpora/**/*.csv
corpora/**/*.zip

# We only allow these specific DuckDBs to be pushed via LFS
!corpora/english/BAWE.duckdb
!corpora/english/BrownCorpus.duckdb
!corpora/english/EN-BPPT-tagged.duckdb
!corpora/indonesian/ID-BPPT-tagged.duckdb
!corpora/indonesian/KOSLAT-full.duckdb

# Exclude giant corpora explicitly
corpora/english/bnc.duckdb
corpora/english/BNC\ Spoken.duckdb

# Stanza Resources
stanza_resources/
home/stanza_resources/

# Temporary / Testing
dummy_corpus.duckdb/
.streamlit/secrets.toml
.DS_Store
Thumbs.db
*.pptx
tests/*.txt
tests/*.xml
tests/debug_*.py
tests/diag_*.py
tests/check_*.py
tests/prototype_*.py
tests/trace_*.py
tests/verify_*.py
tests/extract_*.py
tests/generate_*.py

# Logs and Scratch
*.log
scratch/

# _dont_push folder
_dont_push/

# TreeTagger Models
treetagger/language_model/*
!treetagger/language_model/english/
!treetagger/language_model/indonesian/